	(text "USB-C XIAO — только прошивка. D2 (strap), D6/D7 (UART0), 5V — не подключать.\nVBAT_SENSE — только ADC1 (D0). C7 — у вывода 3V3 XIAO."
		(exclude_from_sim no)
		(at 154.94 175.26 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "1f71c4be-4e69-4ef1-96af-758b52e3c4e9")
	)
	(text "RT1 приклеить к ячейке 18650."
		(exclude_from_sim no)
		(at 93.98 190.5 0)
