	)
	(text "R15: Iзар = 890/R15 ≈ 1.0 А.  R16: Iвх = 1550/R16 ≈ 1.4 А.  EN2=1, EN1=0 → режим ILIM.\nTMR и ITERM не подключены = значения по умолчанию (сверить с даташитом BQ24074)."
		(exclude_from_sim no)
		(at 15.24 107.95 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "65b6d22f-5f07-4864-b924-dedca650f964")
	)
